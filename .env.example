# Firebase web app (public values, from Firebase console → Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Server credentials for local runs against the real project (not needed on App Hosting
# or with the emulators). Base64 of a service-account JSON, or put service-account.json in the root.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Site
NEXT_PUBLIC_SITE_URL="https://your-domain"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""            # optional map embed

# Product name and support contact (lib/brand.ts)
NEXT_PUBLIC_BRAND_NAME="PropPage"
NEXT_PUBLIC_COMPANY_NAME="Rturox"
NEXT_PUBLIC_COMPANY_URL="https://rturox.com"
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_WHATSAPP=""              # digits, e.g. 919876543210
NEXT_PUBLIC_GRIEVANCE_OFFICER=""             # name shown in the privacy policy (DPDP Act)

# Email (Gmail app password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
ADMIN_EMAIL=""

# Daily reminder emails: Cloud Scheduler calls POST /api/cron/daily with
# "Authorization: Bearer <CRON_SECRET>" (32+ random characters)
CRON_SECRET=""

# Local development against the emulators: put these in .env.development.local
# NEXT_PUBLIC_USE_EMULATORS=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8282
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Voice listing (Claude API)
ANTHROPIC_API_KEY=""
LISTING_AI_MODEL="claude-opus-5-5"   # or claude-haiku-5-5 for lower cost
# LISTING_AI_FAKE=1                  # emulator-only stand-in, no API key needed
