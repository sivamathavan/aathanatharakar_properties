rules_version = '2';

// Browsers do not read or write Firestore directly. Every read and write goes
// through the Next.js server (firebase-admin), which bypasses these rules and
// checks roles itself. These rules make sure that a stolen API key or a
// signed-in user calling Firestore from the console gets nothing.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('role', '') == 'ADMIN';
    }

    // A user may read their own profile. Role and status are server-only.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Public listing data is served by the website, but reading an ACTIVE
    // listing directly is harmless. Owner contact lives in /private and stays closed.
    match /properties/{propertyId} {
      allow read: if resource.data.status == 'ACTIVE' || isAdmin();
      allow write: if false;

      match /private/{docId} {
        allow read: if isAdmin()
          || (signedIn() && get(/databases/$(database)/documents/properties/$(propertyId)).data.postedById == request.auth.uid);
        allow write: if false;
      }
    }

    // Prices and payment details shown on the pricing page.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Tracker (back office): admin only.
    match /crm_people/{id}   { allow read: if isAdmin(); allow write: if false; }
    match /crm_deals/{id}    { allow read: if isAdmin(); allow write: if false; }
    match /crm_ledger/{id}   { allow read: if isAdmin(); allow write: if false; }
    match /crm_expenses/{id} { allow read: if isAdmin(); allow write: if false; }
    match /crm_activity/{id} { allow read: if isAdmin(); allow write: if false; }

    // Everything else (agents, leads, payments, slugs, audit, rate limits) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
