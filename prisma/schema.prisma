generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole       @default(PROPERTY_LISTER)
  accountStatus AccountStatus  @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  phone         String?
  accounts      Account[]
  agentProfile  AgentProfile?
  blogPosts     BlogPost[]
  commissions   Commission[]
  leads         Lead[]         @relation("AssignedLeads")
  properties    Property[]
  sessions      Session[]
  vendorProfile VendorProfile?
}

model AgentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  fullName        String
  mobile          String
  reraNumber      String?
  officeAddress   String
  operatingCities String[]
  experience      Int
  bio             String?
  profilePhoto    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model VendorProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  businessName    String
  ownerName       String
  mobile          String
  email           String
  category        VendorCategory
  description     String
  serviceAreas    String[]
  yearsInBusiness Int
  projectsDone    Int?
  priceRangeMin   Int?
  priceRangeMax   Int?
  websiteUrl      String?
  isVerified      Boolean         @default(false)
  isFeatured      Boolean         @default(false)
  rating          Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  enquiries       VendorEnquiry[]
  portfolioMedia  VendorMedia[]
  user            User            @relation(fields: [userId], references: [id])
}

model VendorMedia {
  id           String        @id @default(cuid())
  vendorId     String
  url          String
  thumbnailUrl String?
  publicId     String
  type         MediaType
  caption      String?
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  vendor       VendorProfile @relation(fields: [vendorId], references: [id])
}

model Property {
  id          String          @id @default(cuid())
  title       String
  description String
  type        PropertyType
  listingType ListingType
  price       BigInt
  priceUnit   PriceUnit       @default(TOTAL)
  area        Float
  bedrooms    Int?
  bathrooms   Int?
  floors      Int?
  address     String
  locality    String
  city        String
  district    String
  pincode     String?
  latitude    Float?
  longitude   Float?
  amenities   String[]
  isFeatured  Boolean         @default(false)
  status      PropertyStatus  @default(PENDING)
  viewCount   Int             @default(0)
  postedById  String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  commissions Commission[]
  leads       Lead[]
  postedBy    User            @relation(fields: [postedById], references: [id])
  media       PropertyMedia[]
}

model PropertyMedia {
  id           String    @id @default(cuid())
  propertyId   String
  url          String
  thumbnailUrl String?
  publicId     String
  type         MediaType
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  property     Property  @relation(fields: [propertyId], references: [id])
}

model Lead {
  id            String     @id @default(cuid())
  propertyId    String?
  name          String
  email         String
  message       String
  status        LeadStatus @default(NEW)
  assignedToId  String?
  source        LeadSource @default(WEB)
  siteVisitDate DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  assignedTo    User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  property      Property?  @relation(fields: [propertyId], references: [id])
  notes         LeadNote[]
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  note      String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
}

model VendorEnquiry {
  id        String        @id @default(cuid())
  vendorId  String
  name      String
  email     String
  message   String
  status    LeadStatus    @default(NEW)
  createdAt DateTime      @default(now())
  vendor    VendorProfile @relation(fields: [vendorId], references: [id])
}

model Commission {
  id            String           @id @default(cuid())
  leadId        String?
  propertyId    String?
  type          CommissionType
  amount        BigInt
  status        CommissionStatus @default(EXPECTED)
  notes         String?
  dueDate       DateTime?
  receivedDate  DateTime?
  createdBy     String
  createdAt     DateTime         @default(now())
  createdByUser User             @relation(fields: [createdBy], references: [id])
  property      Property?        @relation(fields: [propertyId], references: [id])
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String
  excerpt         String
  coverImageUrl   String?
  coverPublicId   String?
  tags            String[]
  metaTitle       String?
  metaDescription String?
  authorId        String
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  viewCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  author          User      @relation(fields: [authorId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  AGENT
  VENDOR
  PROPERTY_LISTER
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum VendorCategory {
  BUILDER
  INTERIOR_DESIGNER
  PAINTER
  ELECTRICIAN
  PLUMBER
  CARPENTER
  ARCHITECT
  VASTU_CONSULTANT
  HOME_LOAN_ADVISOR
  MOVERS_PACKERS
  TILES_FLOORING
  CIVIL_CONTRACTOR
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  PLOT
  COMMERCIAL
  WAREHOUSE
  FARM_LAND
  PG_HOSTEL
}

enum ListingType {
  BUY
  SELL
  RENT
  LEASE
}

enum PriceUnit {
  TOTAL
  PER_SQFT
  PER_MONTH
  PER_YEAR
}

enum PropertyStatus {
  PENDING
  ACTIVE
  SOLD
  RENTED
  REJECTED
  INACTIVE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum LeadStatus {
  NEW
  CONTACTED
  SITE_VISIT
  NEGOTIATION
  CLOSED
  LOST
}

enum LeadSource {
  WEB
  WHATSAPP
  REFERRAL
  DIRECT
}

enum CommissionType {
  PROPERTY_SALE
  PROPERTY_RENTAL
  PROPERTY_LEASE
  BUILDER_REFERRAL
  INTERIOR_REFERRAL
  PAINTER_REFERRAL
  ELECTRICIAN_REFERRAL
  HOME_LOAN_REFERRAL
  OTHER_SERVICE
  PLATFORM_FEE
}

enum CommissionStatus {
  EXPECTED
  RECEIVED
  CANCELLED
}
