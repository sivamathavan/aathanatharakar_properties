// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          UserRole  @default(PROPERTY_LISTER)
  accountStatus AccountStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  agentProfile    AgentProfile?
  vendorProfile   VendorProfile?
  properties      Property[]
  leads           Lead[]        @relation("AssignedLeads")
  blogPosts       BlogPost[]
  commissions     Commission[]
  accounts        Account[]
  sessions        Session[]
}

enum UserRole {
  ADMIN
  AGENT
  VENDOR
  PROPERTY_LISTER
}

enum AccountStatus {
  PENDING       // waiting admin approval (agents + vendors)
  ACTIVE        // approved and can operate
  REJECTED      // admin rejected
  SUSPENDED     // admin suspended
}

model AgentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  fullName        String
  mobile          String
  reraNumber      String?
  officeAddress   String
  operatingCities String[] // array of TN city names
  experience      Int      // years of experience
  bio             String?
  profilePhoto    String?  // Cloudinary URL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VendorProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  businessName    String
  ownerName       String
  mobile          String
  email           String
  category        VendorCategory
  description     String
  serviceAreas    String[]       // array of TN city/district names
  yearsInBusiness Int
  projectsDone    Int?
  priceRangeMin   Int?
  priceRangeMax   Int?
  websiteUrl      String?
  isVerified      Boolean        @default(false)
  isFeatured      Boolean        @default(false)
  rating          Float?
  portfolioMedia  VendorMedia[]
  enquiries       VendorEnquiry[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum VendorCategory {
  BUILDER
  INTERIOR_DESIGNER
  PAINTER
  ELECTRICIAN
  PLUMBER
  CARPENTER
  ARCHITECT
  VASTU_CONSULTANT
  HOME_LOAN_ADVISOR
  MOVERS_PACKERS
  TILES_FLOORING
  CIVIL_CONTRACTOR
}

model VendorMedia {
  id          String      @id @default(cuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id])
  url         String
  thumbnailUrl String?
  publicId    String
  type        MediaType
  caption     String?
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
}

model Property {
  id           String        @id @default(cuid())
  title        String
  description  String
  type         PropertyType
  listingType  ListingType
  price        BigInt
  priceUnit    PriceUnit     @default(TOTAL)
  area         Float
  bedrooms     Int?
  bathrooms    Int?
  floors       Int?
  address      String
  locality     String
  city         String
  district     String
  pincode      String?
  latitude     Float?
  longitude    Float?
  amenities    String[]
  isFeatured   Boolean       @default(false)
  status       PropertyStatus @default(PENDING)
  viewCount    Int           @default(0)
  postedById   String
  postedBy     User          @relation(fields: [postedById], references: [id])
  media        PropertyMedia[]
  leads        Lead[]
  commissions  Commission[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  PLOT
  COMMERCIAL
  WAREHOUSE
  FARM_LAND
  PG_HOSTEL
}

enum ListingType {
  BUY
  SELL
  RENT
  LEASE
}

enum PriceUnit {
  TOTAL
  PER_SQFT
  PER_MONTH
  PER_YEAR
}

enum PropertyStatus {
  PENDING
  ACTIVE
  SOLD
  RENTED
  REJECTED
  INACTIVE
}

model PropertyMedia {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id])
  url          String
  thumbnailUrl String?
  publicId     String
  type         MediaType
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
}

model Lead {
  id           String     @id @default(cuid())
  propertyId   String?
  property     Property?  @relation(fields: [propertyId], references: [id])
  name         String
  email        String
  message      String
  status       LeadStatus @default(NEW)
  assignedToId String?
  assignedTo   User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  source       LeadSource @default(WEB)
  notes        LeadNote[]
  siteVisitDate DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  SITE_VISIT
  NEGOTIATION
  CLOSED
  LOST
}

enum LeadSource {
  WEB
  WHATSAPP
  REFERRAL
  DIRECT
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  note      String
  createdAt DateTime @default(now())
}

model VendorEnquiry {
  id        String        @id @default(cuid())
  vendorId  String
  vendor    VendorProfile @relation(fields: [vendorId], references: [id])
  name      String
  email     String
  message   String
  status    LeadStatus    @default(NEW)
  createdAt DateTime      @default(now())
}

model Commission {
  id           String           @id @default(cuid())
  leadId       String?
  propertyId   String?
  property     Property?        @relation(fields: [propertyId], references: [id])
  type         CommissionType
  amount       BigInt
  status       CommissionStatus @default(EXPECTED)
  notes        String?
  dueDate      DateTime?
  receivedDate DateTime?
  createdBy    String
  createdByUser User            @relation(fields: [createdBy], references: [id])
  createdAt    DateTime         @default(now())
}

enum CommissionType {
  PROPERTY_SALE
  PROPERTY_RENTAL
  PROPERTY_LEASE
  BUILDER_REFERRAL
  INTERIOR_REFERRAL
  PAINTER_REFERRAL
  ELECTRICIAN_REFERRAL
  HOME_LOAN_REFERRAL
  OTHER_SERVICE
  PLATFORM_FEE
}

enum CommissionStatus {
  EXPECTED
  RECEIVED
  CANCELLED
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String
  excerpt         String
  coverImageUrl   String?
  coverPublicId   String?
  tags            String[]
  metaTitle       String?
  metaDescription String?
  authorId        String
  author          User      @relation(fields: [authorId], references: [id])
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  viewCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}
